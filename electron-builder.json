{
  "appId": "com.soutienscolaire.admin",
  "productName": "Centre Soutien Scolaire",
  "directories": {
    "output": "dist-installer"
  },
  "npmRebuild": true,
  "files": [
    "dist/**/*",
    "electron/**/*",
    "public/**/*",
    "package.json"
  ],
  "mac": {
    "target": [
      "dmg",
      "zip"
    ]
  },
  "dmg": {
    "title": "Centre Soutien Scolaire"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowElevation": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Centre Soutien Scolaire"
  }
}
