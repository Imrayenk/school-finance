{
  "name": "espoir-admin",
  "productName": "Espoir",
  "version": "0.0.1",
  "private": true,
  "description": "Desktop relational database application for Soutien Scolaire center management",
  "author": "Centre Soutien Scolaire",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "electron .",
    "package": "node scripts/package_app.mjs",
    "setup": "node scripts/build_setup.mjs",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "build": {
    "appId": "com.espoir.app",
    "productName": "Espoir",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "shortcutName": "Espoir"
    }
  },
  "dependencies": {
    "better-sqlite3": "^9.6.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.14.2",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^29.4.6",
    "electron-builder": "^26.15.3",
    "electron-winstaller": "^5.4.4",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
